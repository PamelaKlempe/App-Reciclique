<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppReciclique.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F5F5">

  <Grid>
        <!-- FUNDO -->
        <Image Source="folhaslogin.png"
        Aspect="AspectFill"
        Opacity="0.85"/>

      <VerticalStackLayout Padding="40" Spacing="7" VerticalOptions="Start">

        <!-- LOGO -->
        <Image Source="logo.png"
               HorizontalOptions="Center"
               HeightRequest="180"
               Aspect="AspectFit"/>


            <Label Text="Bem-vindo!"
       FontSize="18"
       FontAttributes="Bold"
       TextColor="#1B365D"
       HorizontalOptions="Center"/>

            <Label Text="Faça login para continuar sua jornada sustentável."
       FontSize="12"
       TextColor="#707070"
       HorizontalTextAlignment="Center"
       Margin="0,0,0,1"/>



            <!-- EMAIL -->
        <Frame CornerRadius="16"
               BackgroundColor="#f9ffffff"
               Padding="8">

            <Entry x:Name="txtEmail"
                   Placeholder="E-mail"
                   Keyboard="Email"
                   TextColor="Black"/>
        </Frame>

        <!-- SENHA -->
        <Frame CornerRadius="16"
               BackgroundColor="#f9ffffff"
               Padding="8">

            <Entry x:Name="txtSenha"
                   Placeholder="Senha"
                   IsPassword="True"
                   TextColor="Black"/>
        </Frame>

        <!-- BOTÃO -->
        <Button Text="Entrar"
                BackgroundColor="#388E3C"
                TextColor="White"
                CornerRadius="16"
                HeightRequest="50"
                Clicked="OnLoginClicked"/>

      </VerticalStackLayout>

  </Grid>
    
</ContentPage>