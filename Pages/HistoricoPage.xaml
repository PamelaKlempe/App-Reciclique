<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:AppReciclique.Models"
    x:Class="AppReciclique.HistoricoPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">


    <Grid>
        <!-- FUNDO -->
        <Image Source="folhashistorico.jpeg"
        Aspect="AspectFill"
          Opacity="0.90"/>

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- TOPO -->
            <VerticalStackLayout 
 BackgroundColor="Transparent" 
Spacing="5"
 Padding="20,50,20,0"
 Grid.Row="0">

                <Label Text=  "Histótico de Atividades"
    TextColor="#1f6b3a"
    FontSize="25"
    FontAttributes="Bold"/>

            </VerticalStackLayout>


            <!-- LISTA -->
            <CollectionView Grid.Row="1"
                        x:Name="listaHistorico"
                        Margin="15">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Agendamento">

                        <Frame Margin="5"
                           Padding="12"
                           BackgroundColor="White"
                           CornerRadius="12"
                           HasShadow="True">

                            <VerticalStackLayout Spacing="6">

                                <!-- TIPO -->
                                <Label Text="{Binding Tipo}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="#2E7D32"/>

                                <!-- ENDEREÇO -->
                                <Label Text="{Binding Endereco}"
                                   FontSize="14"
                                   LineBreakMode="WordWrap"/>

                                <!-- DATA -->
                                <Label Text="{Binding Data, StringFormat='📅 Data: {0:dd/MM/yyyy}'}"
                                   FontSize="12"
                                   TextColor="Gray"/>

                                <!-- HORA -->
                                <Label Text="{Binding Hora, StringFormat='⏰ Hora: {0}'}"
                                   FontSize="12"
                                   TextColor="Gray"/>

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- MENU -->
            <Grid Grid.Row="2" BackgroundColor="#f8f8f4" Padding="5">

                

                <VerticalStackLayout HorizontalOptions="Start"
                                 Margin="10,0,0,0">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeClicked"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <Label Text="🏠" FontSize="25"/>
                  

                </VerticalStackLayout>

            </Grid>

        </Grid>
    </Grid>

</ContentPage>