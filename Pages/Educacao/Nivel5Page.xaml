<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppReciclique.Pages.Educacao.Nivel5Page"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- TOPO (ROW 0) -->
        <VerticalStackLayout BackgroundColor="#2E7D32" Padding="10" Grid.Row="0">

            <Label Text="←"
           TextColor="White"
           FontSize="20">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVoltarClicked"/>
                </Label.GestureRecognizers>
            </Label>

            <Label Text="NÍVEL 5 — AÇÃO NA PRÁTICA (MUTIRÃO)"
           TextColor="white"
           FontSize="12"
FontAttributes="Bold"/>
        </VerticalStackLayout>



        <!-- CONTEÚDO (ROW 1) -->
        
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- BOTÃO 1 -->
                <Frame CornerRadius="18" HeightRequest="140">
                    <Grid>
                        <Image Source="https://images.pexels.com/photos/7538360/pexels-photo-7538360.jpeg?_gl=1*1r4e65q*_ga*NDc3MzY4NDYzLjE3NzY4MTQxNDQ.*_ga_8JE65Q40S6*czE3Nzc2NzUwMDIkbzUkZzEkdDE3Nzc2NzUwMTAkajUyJGwwJGgw"
         Aspect="AspectFill"
         Opacity="0.45"/>

                        <Button Text="1- Como cuidar do Meio Ambiente?"
          BackgroundColor="Transparent"
          TextColor="#1B5E20"
          FontAttributes="Bold"
          FontSize="20"
          Clicked="OnComoClicked"/>
                    </Grid>
                </Frame>

                <!-- BOTÃO 2 -->
                <Frame CornerRadius="18" HeightRequest="140">
                    <Grid>
                        <Image Source="https://images.pexels.com/photos/9543740/pexels-photo-9543740.jpeg?_gl=1*19asy2g*_ga*NDc3MzY4NDYzLjE3NzY4MTQxNDQ.*_ga_8JE65Q40S6*czE3Nzc2NzUwMDIkbzUkZzEkdDE3Nzc2NzUzNDkkajU5JGwwJGgw"
         Aspect="AspectFill"
         Opacity="0.45"/>
                        <Button Text="2- Por que cuidar do Meio Ambiente?"
          BackgroundColor="Transparent"
          TextColor="#1B5E20"
          FontAttributes="Bold"
          FontSize="20"
          Clicked="OnCuidarClicked"/>
                    </Grid>
                </Frame>

                <!-- BOTÃO 3 -->
                <Frame CornerRadius="18" HeightRequest="140">
                    <Grid>
                        <Image Source="https://images.pexels.com/photos/36713478/pexels-photo-36713478.jpeg?_gl=1*1fg0g69*_ga*NDc3MzY4NDYzLjE3NzY4MTQxNDQ.*_ga_8JE65Q40S6*czE3Nzc2NzUwMDIkbzUkZzEkdDE3Nzc2NzUzOTUkajEzJGwwJGgw"
         Aspect="AspectFill"
         Opacity="0.45"/>
                        <Button Text="3- Curta - A Terra"
          BackgroundColor="Transparent"
          TextColor="#1B5E20"
          FontAttributes="Bold"
          FontSize="20"
          Clicked="OnCurtaClicked"/>
                    </Grid>
                </Frame>

                <!-- BOTÃO 4 -->
                <Frame CornerRadius="18" HeightRequest="140">
                    <Grid>
                        <Image Source="https://images.pexels.com/photos/19507080/pexels-photo-19507080.jpeg?_gl=1*1uh39bk*_ga*NDc3MzY4NDYzLjE3NzY4MTQxNDQ.*_ga_8JE65Q40S6*czE3Nzc2NzUwMDIkbzUkZzEkdDE3Nzc2NzU0NDYkajM1JGwwJGgw"
         Aspect="AspectFill"
         Opacity="0.45"/>
                        <Button Text="4- Sungai Watch e seu Trabalho"
          BackgroundColor="Transparent"
          TextColor="#1B5E20"
          FontAttributes="Bold"
          FontSize="20"
          Clicked="OnCadeiraClicked"/>
                    </Grid>
                </Frame>

                <!-- BOTÃO 5 -->
                <Frame CornerRadius="18" HeightRequest="140">
                    <Grid>
                        <Image Source="https://images.pexels.com/photos/8542545/pexels-photo-8542545.jpeg?_gl=1*7jkxfr*_ga*NDc3MzY4NDYzLjE3NzY4MTQxNDQ.*_ga_8JE65Q40S6*czE3Nzc2NzUwMDIkbzUkZzEkdDE3Nzc2NzU0ODQkajU5JGwwJGgw"
         Aspect="AspectFill"
         Opacity="0.45"/>
                        <Button Text="5- Pesquisa de Carlos Nobre"
          BackgroundColor="Transparent"
          TextColor="#1B5E20"
          FontAttributes="Bold"
          FontSize="20"
          Clicked="OnTempoClicked"/>
                    </Grid>
                </Frame>


            </VerticalStackLayout>

        </ScrollView>


        <!-- MENU HOME (ROW 2) -->
        <Grid Grid.Row="2" BackgroundColor="White" Padding="10">

            <!-- LINHA VERDE -->
            <BoxView HeightRequest="2"
             BackgroundColor="#2E7D32"
             VerticalOptions="Start"/>

            <!-- BOTÃO HOME -->
            <VerticalStackLayout HorizontalOptions="Start"
                         Margin="10,10,0,0">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeClicked"/>
                </VerticalStackLayout.GestureRecognizers>

                <Label Text="🏠"
               FontSize="24"
               HorizontalOptions="Center"/>

                <Label Text="Home"
               FontSize="10"
               HorizontalOptions="Center"/>

            </VerticalStackLayout>

        </Grid>

    </Grid>
</ContentPage>