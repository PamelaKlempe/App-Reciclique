<ContentPage 
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Class="AppReciclique.Pages.Educacao.Nivel5Page"
	NavigationPage.HasNavigationBar="False"
	BackgroundColor="#F5F5F5">

    <Grid>
        <!-- FUNDO -->
        <Image Source="folhabonus.jpeg"
		   Aspect="AspectFill"
		   Opacity="1"/>

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- TOPO (ROW 0) -->
            <VerticalStackLayout 
					BackgroundColor="Transparent" 
					Spacing="5"
					Padding="0,35,0,0"
					Grid.Row="0">

                <Label Text="♻️ NÍVEL 5"
				   TextColor="#1B365D"
				   FontSize="23"
				   HorizontalOptions="Center"
				   FontFamily="MontserratExtraBold"
				   FontAttributes="Bold"/>

                <Label Text="AÇÃO NA PRÁTICA (MUTIRÃO)"
				   TextColor="#1B364A"
				   FontSize="15"
				   HorizontalOptions="Center"
				   FontFamily="MontserratExtraBold"
				   FontAttributes="Bold"/>

                <BoxView HeightRequest="3"
					 WidthRequest="300"
					 Color="#7FA87C"
					 CornerRadius="4"
					 HorizontalOptions="Center"/>

            </VerticalStackLayout>


            <!-- CONTEÚDO (ROW 1) -->
            <ScrollView Grid.Row="1">

                <VerticalStackLayout Padding="20" Spacing="18">

                    <!-- CARD 1 -->
                    <Frame CornerRadius="18"
						   BackgroundColor="#EEF5EA"
						   BorderColor="#BFCDB8"
						   Padding="15"
						   Margin="0"
						   HasShadow="True">

                        <VerticalStackLayout>

                            <Label Text="1️⃣ - Cuidar do Meio Ambiente"
							   FontFamily="MontserratExtraBold"
							   FontAttributes="Bold"
							   FontSize="18"
							   TextColor="#1B5E20"/>

                            <Image Source="ambiente.jpg"
							   HeightRequest="110"
							   Aspect="AspectFill"
							   Margin="0,10,0,0"/>

                        </VerticalStackLayout>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnComoClicked"/>
                        </Frame.GestureRecognizers>

                    </Frame>

                    <!-- CARD 2 -->
                    <Frame CornerRadius="18"
					   BackgroundColor="#EEF5EA"
					   BorderColor="#BFCDB8"
					   Padding="15"
					   Margin="0"
					   HasShadow="True">

                        <VerticalStackLayout>

                            <Label Text="2️⃣ - Por que Cuidar?"
							   FontFamily="MontserratExtraBold"
							   FontAttributes="Bold"
							   FontSize="18"
							   TextColor="#1B5E20"/>

                            <Image Source="cuidar.jpg"
							   HeightRequest="110"
							   Aspect="AspectFill"
							   Margin="0,10,0,0"/>

                        </VerticalStackLayout>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCuidarClicked"/>
                        </Frame.GestureRecognizers>

                    </Frame>

                    <!-- CARD 3 -->
                    <Frame CornerRadius="18"
					   BackgroundColor="#EEF5EA"
					   BorderColor="#BFCDB8"
					   Padding="15"
					   Margin="0"
					   HasShadow="True">

                        <VerticalStackLayout>

                            <Label Text="3️⃣ - Curta a Terra"
							   FontFamily="MontserratExtraBold"
							   FontAttributes="Bold"
							   FontSize="18"
							   TextColor="#1B5E20"/>

                            <Image Source="terra.jpg"
							   HeightRequest="110"
							   Aspect="AspectFill"
							   Margin="0,10,0,0"/>

                        </VerticalStackLayout>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCurtaClicked"/>
                        </Frame.GestureRecognizers>

                    </Frame>

                    <!-- CARD 4 -->
                    <Frame CornerRadius="18"
					   BackgroundColor="#EEF5EA"
					   BorderColor="#BFCDB8"
					   Padding="15"
					   Margin="0"
					   HasShadow="True">

                        <VerticalStackLayout>

                            <Label Text="4️⃣ - Sungai Watch"
							   FontFamily="MontserratExtraBold"
							   FontAttributes="Bold"
							   FontSize="18"
							   TextColor="#1B5E20"/>

                            <Image Source="sungai.jpg"
							   HeightRequest="110"
							   Aspect="AspectFill"
							   Margin="0,10,0,0"/>

                        </VerticalStackLayout>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCadeiraClicked"/>
                        </Frame.GestureRecognizers>

                    </Frame>

                    <!-- CARD 5 -->
                    <Frame CornerRadius="18"
						   BackgroundColor="#EEF5EA"
						   BorderColor="#BFCDB8"
						   Padding="15"
						   Margin="0"
						   HasShadow="True">	

                        <VerticalStackLayout>

                            <Label Text="5️⃣ - Carlos Nobre"
								   FontFamily="MontserratExtraBold"
								   FontAttributes="Bold"
								   FontSize="18"
								   TextColor="#1B5E20"/>

                            <Image Source="carlos.jpg"
							   HeightRequest="110"
							   Aspect="AspectFill"
							   Margin="0,10,0,0"/>

                        </VerticalStackLayout>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTempoClicked"/>
                        </Frame.GestureRecognizers>

                    </Frame>

                </VerticalStackLayout>

            </ScrollView>


            <!-- MENU HOME (ROW 2) -->
            <Grid Grid.Row="2" BackgroundColor="White" Padding="5">



                <!-- BOTÃO HOME -->
                <VerticalStackLayout HorizontalOptions="Start"
						 Margin="10,0,0,0">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeClicked"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <Label Text="🏠"
					   FontSize="24"
					   HorizontalOptions="Center"/>


                </VerticalStackLayout>

            </Grid>
        </Grid>

    </Grid>
</ContentPage>
