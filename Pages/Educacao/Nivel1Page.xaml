<ContentPage 
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Class="AppReciclique.Pages.Educacao.Nivel1Page"
	NavigationPage.HasNavigationBar="False"
	BackgroundColor="#F5F5F5">

    <Grid>
        <!-- FUNDO -->
        <Image Source="folhabonus.jpeg"
	            Aspect="AspectFill"
	            Opacity="0.98"/>



        <Grid RowDefinitions="Auto,*,Auto">

            <!-- TOPO (ROW 0) -->
            <VerticalStackLayout 
                BackgroundColor="Transparent" 
                Spacing="5"
                Padding="0,35,0,0"
                Grid.Row="0">

                <Label Text=  " ♻️ NÍVEL 1"
					TextColor="#1B365D"
					FontSize="23"
				   HorizontalOptions="Center" 
					   FontFamily="MontserratExtraBold"
					FontAttributes="Bold"/>

                <Label Text=  "O BÁSICO DA RECICLAGEM"
	                TextColor="#1B364a"
	                FontSize="15"
                    HorizontalOptions="Center" 
	                FontFamily="MontserratExtraBold"
	                FontAttributes="Bold"/>

                <BoxView HeightRequest="3"
			        WidthRequest="300"
			        Color="#7FA87C"
			        CornerRadius="4"
			        HorizontalOptions="Center"/>


            </VerticalStackLayout>


            <!-- CONTEÚDO (ROW 1) -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20" Spacing="18">

                    <!-- BOTÃO 1 -->
                    <Frame CornerRadius="18"
							   BackgroundColor="#EEF5EA"
							   BorderColor="#BFCDB8"
							   Padding="15"
								 Margin="0"
							   HasShadow="True">


                        <VerticalStackLayout>

                            <Label Text="1️⃣ - Vidro" FontAttributes="Bold" 
								FontFamily="MontserratExtraBold"
									 FontSize="18"
								TextColor="#1B5E20"/>


                            <Image Source= "vidro2.jpg"
								HeightRequest="110"
								Aspect="AspectFill"
								Margin="0,10,0,0"/>

                        </VerticalStackLayout>

                        <!-- clique -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVidroClicked"/>
                        </Frame.GestureRecognizers>


                    </Frame>

                    <!-- BOTÃO 2 -->
                    <Frame CornerRadius="18"
						   BackgroundColor="#EEF5EA"
						    BorderColor="#BFCDB8"
							Padding="15"
												Margin="0"
							   HasShadow="True">


                        <VerticalStackLayout>

                            <Label Text="2️⃣ - Plástico" FontAttributes="Bold"
							 FontFamily="MontserratExtraBold"
								FontSize="18"
							    TextColor="#1B5E20"/>


                            <Image Source="plastico.jpg"
								HeightRequest="110"
								Aspect="AspectFill"
								Margin="0,10,0,0"/>
                        </VerticalStackLayout>


                        <!-- clique -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlasticoClicked"/>
                        </Frame.GestureRecognizers>


                    </Frame>



                    <!-- BOTÃO 3 -->

                    <Frame CornerRadius="18"
							   BackgroundColor="#EEF5EA"
							   BorderColor="#BFCDB8"
							   Padding="15"
												Margin="0"
							   HasShadow="True">


                        <VerticalStackLayout>

                            <Label Text="3️⃣ - Papel" FontAttributes="Bold"
			                  FontFamily="MontserratExtraBold"     
								   FontSize="18"
			                       TextColor="#1B5E20"/>


                            <Image Source= "papel2.jpg"
							HeightRequest="110"
							Aspect="AspectFill"
							Margin="0,10,0,0"/>

                        </VerticalStackLayout>

                        <!-- clique -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPapelClicked"/>
                        </Frame.GestureRecognizers>


                    </Frame>

                    <!-- BOTÃO 4 -->
                    <Frame CornerRadius="18"
							   BackgroundColor="#EEF5EA"
							   BorderColor="#BFCDB8"
							   Padding="15"
												Margin="0"
							   HasShadow="True">


                        <VerticalStackLayout>

                            <Label Text="4️⃣ - Metal" FontAttributes="Bold"
								FontFamily="MontserratExtraBold"
								   FontSize="18"
								TextColor="#1B5E20"/>


                            <Image Source= "metal.jpg"
								HeightRequest="110"
								Aspect="AspectFill"
								Margin="0,10,0,0"/>

                        </VerticalStackLayout>

                        <!-- clique -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMetalClicked"/>
                        </Frame.GestureRecognizers>


                    </Frame>
                </VerticalStackLayout>



            </ScrollView>
            <!-- MENU HOME (ROW 2) -->
            <Grid Grid.Row="2" BackgroundColor="White" Padding="5">



                <!-- BOTÃO HOME -->
                <VerticalStackLayout HorizontalOptions="Start"
						 Margin="10,0,0,0">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeClicked"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <Label Text="🏠"
			            FontSize="24"
			            HorizontalOptions="Center"/>


                </VerticalStackLayout>

            </Grid>

        </Grid>
    </Grid>


</ContentPage>
