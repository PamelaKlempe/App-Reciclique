<ContentPage 
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Class="AppReciclique.Pages.Educacao.Nivel6Page"
	NavigationPage.HasNavigationBar="False"
	BackgroundColor="#F5F5F5">

	<Grid>
		<!-- FUNDO -->
		<Image Source="folhabonus.jpeg"
		   Aspect="AspectFill"
		   Opacity="1"/>



		<Grid RowDefinitions="Auto,*,Auto">

			<!-- TOPO (ROW 0) -->
			<VerticalStackLayout 
				BackgroundColor="Transparent"
				Spacing="5"
				Padding="0,35,0,0"
				Grid.Row="0">

				<Label Text="♻️ NÍVEL 6"
				   TextColor="#1B365D"
				   FontSize="23"
				   HorizontalOptions="Center"
				   FontFamily="MontserratExtraBold"
				   FontAttributes="Bold"/>

                <Label Text="REUTILIZAÇÃO CRIATIVA"
				   TextColor="#1B364A"
				   FontSize="15"
				   HorizontalOptions="Center"
				   FontFamily="MontserratExtraBold"
				   FontAttributes="Bold"/>

                <BoxView HeightRequest="3"
					 WidthRequest="300"
					 Color="#7FA87C"
					 CornerRadius="4"
					 HorizontalOptions="Center"/>

			</VerticalStackLayout>


			<!-- CONTEÚDO (ROW 1) -->
			<ScrollView Grid.Row="1">

				<VerticalStackLayout Padding="20" Spacing="18">

					<!-- CARD 1 -->
                    <Frame CornerRadius="18"
					   BackgroundColor="#EEF5EA"
					   BorderColor="#BFCDB8"
					   Padding="15"
					   Margin="0"
					   HasShadow="True">	

                        <VerticalStackLayout>

                            <Label Text="1️⃣ - Artesanato com Papel"
							   FontFamily="MontserratExtraBold"
							   FontAttributes="Bold"
							   FontSize="18"
							   TextColor="#1B5E20"/>

                            <Image Source="artepapel.jpg"
							   HeightRequest="110"
							   Aspect="AspectFill"
							   Margin="0,10,0,0"/>

						</VerticalStackLayout>

						<Frame.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnPaperClicked"/>
						</Frame.GestureRecognizers>

					</Frame>

					<!-- CARD 2 -->
                    <Frame CornerRadius="18"
					   BackgroundColor="#EEF5EA"
					   BorderColor="#BFCDB8"
					   Padding="15"
					   Margin="0"
					   HasShadow="True">

                        <VerticalStackLayout>

                            <Label Text="2️⃣ - Colheres de Plástico"
							   FontFamily="MontserratExtraBold"
							   FontAttributes="Bold"
							   FontSize="18"
							   TextColor="#1B5E20"/>

                            <Image Source="colheres.jpg"
							   HeightRequest="110"
							   Aspect="AspectFill"
							   Margin="0,10,0,0"/>

                        </VerticalStackLayout>

						<Frame.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnColheresClicked"/>
						</Frame.GestureRecognizers>

					</Frame>

					<!-- CARD 3 -->
					<Frame CornerRadius="18"
					   BackgroundColor="#EEF5EA"
					   BorderColor="#BFCDB8"
					   Padding="15"
					   Margin="0"
					   HasShadow="True">

						<VerticalStackLayout>

							<Label Text="3️⃣ - Rolinho de Papel"
							   FontFamily="MontserratExtraBold"
							   FontAttributes="Bold"
							   FontSize="18"
							   TextColor="#1B5E20"/>

                            <Image Source="rolinho.jpg"
							   HeightRequest="110"
							   Aspect="AspectFill"
							   Margin="0,10,0,0"/>

                        </VerticalStackLayout>

						<Frame.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnOvelhaClicked"/>
						</Frame.GestureRecognizers>

					</Frame>

					<!-- CARD 4 -->
					<Frame CornerRadius="18"
					   BackgroundColor="#EEF5EA"
					   BorderColor="#BFCDB8"
					   Padding="15"
					   Margin="0"
					   HasShadow="True">

						<VerticalStackLayout>

                            <Label Text="4️⃣ - Arte com Entulho"
						   FontFamily="MontserratExtraBold"
						   FontAttributes="Bold"
						   FontSize="18"
						   TextColor="#1B5E20"/>

                            <Image Source="arteentulho.jpg"
							   HeightRequest="110"
							   Aspect="AspectFill"
							   Margin="0,10,0,0"/>

                        </VerticalStackLayout>

						<Frame.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnArteClicked"/>
						</Frame.GestureRecognizers>

					</Frame>

					<!-- CARD 5 -->
					<Frame CornerRadius="18"
						   BackgroundColor="#EEF5EA"
						   BorderColor="#BFCDB8"
						   Padding="15"
						   Margin="0"
						   HasShadow="True">

						<VerticalStackLayout>

                            <Label Text="5️⃣ - Ideias para Brinquedos"
							   FontFamily="MontserratExtraBold"
							   FontAttributes="Bold"
							   FontSize="18"
							   TextColor="#1B5E20"/>

                            <Image Source="ideias.jpg"
							   HeightRequest="110"
							   Aspect="AspectFill"
							   Margin="0,10,0,0"/>

						</VerticalStackLayout>

						<Frame.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnIdeiaClicked"/>
						</Frame.GestureRecognizers>

					</Frame>

				</VerticalStackLayout>

			</ScrollView>


			<!-- MENU HOME (ROW 2) -->
			<Grid Grid.Row="2" BackgroundColor="White" Padding="0">




				<!-- BOTÃO HOME -->
				<VerticalStackLayout HorizontalOptions="Start"
			  Margin="10,0,0,0">

					<VerticalStackLayout.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnHomeClicked"/>
					</VerticalStackLayout.GestureRecognizers>

					<Label Text="🏠"
						FontSize="24"
						HorizontalOptions="Center"/>


				</VerticalStackLayout>

			</Grid>
		</Grid>

	</Grid>
</ContentPage>        
