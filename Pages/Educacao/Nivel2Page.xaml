<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppReciclique.Pages.Educacao.Nivel2Page"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">

  <Grid RowDefinitions="Auto,*,Auto">

        <!-- TOPO (ROW 0) -->
        <VerticalStackLayout 
    BackgroundColor="Transparent" 
    Spacing="5"
    Padding="20,20,20,0"
    Grid.Row="0">

            <Label Text=  "NÍVEL 2 — LIXO ORGÂNICO E ALIMENTO"
    TextColor="#1B365D"
    FontSize="13"
    FontAttributes="Bold"/>

        </VerticalStackLayout>



        <!-- CONTEÚDO (ROW 1) -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- BOTÃO 1 -->
                <Frame CornerRadius="18" HeightRequest="140">
                    <Grid>
                        <Image Source="https://images.pexels.com/photos/30684081/pexels-photo-30684081.jpeg?_gl=1*1h3vq5s*_ga*NDc3MzY4NDYzLjE3NzY4MTQxNDQ.*_ga_8JE65Q40S6*czE3NzY4MTQxNDMkbzEkZzEkdDE3NzY4MTQxNjQkajM5JGwwJGgw"
                         Aspect="AspectFill"
                         Opacity="0.45"/>

                        <Button Text="1- O Que é Lixo Orgânico?"
                          BackgroundColor="Transparent"
                          TextColor="#1B5E20"
                          FontAttributes="Bold"
                          FontSize="20"
                          Clicked="OnLixoOrganicoClicked"/>
                    </Grid>
                </Frame>

                <!-- BOTÃO 2 -->
                <Frame CornerRadius="18" HeightRequest="140">
                    <Grid>
                        <Image Source="https://images.pexels.com/photos/31416063/pexels-photo-31416063.jpeg?_gl=1*1s0p72h*_ga*NDc3MzY4NDYzLjE3NzY4MTQxNDQ.*_ga_8JE65Q40S6*czE3NzY4MTQxNDMkbzEkZzEkdDE3NzY4MTQyNzMkajU1JGwwJGgw"
                         Aspect="AspectFill"
                         Opacity="0.45"/>
                        <Button Text="2- O que é Compostagem?"
                          BackgroundColor="Transparent"
                          TextColor="#1B5E20"
                          FontAttributes="Bold"
                          FontSize="20"
                          Clicked="OnCompostagemClicked"/>
                    </Grid>
                </Frame>

                <!-- BOTÃO 3 -->
                <Frame CornerRadius="18" HeightRequest="140">
                    <Grid>
                        <Image Source="https://images.pexels.com/photos/3696170/pexels-photo-3696170.jpeg?_gl=1*1nw5rss*_ga*NDc3MzY4NDYzLjE3NzY4MTQxNDQ.*_ga_8JE65Q40S6*czE3NzY4MTQxNDMkbzEkZzEkdDE3NzY4MTQzMTUkajEzJGwwJGgw"
                         Aspect="AspectFill"
                         Opacity="0.45"/>
                        <Button Text="3- Compostagem em Casa"
                          BackgroundColor="Transparent"
                          TextColor="#1B5E20"
                          FontAttributes="Bold"
                          FontSize="20"
                          Clicked="OnPassosClicked"/>
                    </Grid>
                </Frame>

                <!-- BOTÃO 4 -->
                <Frame CornerRadius="18" HeightRequest="140">
                    <Grid>
                        <Image Source="https://images.pexels.com/photos/34118366/pexels-photo-34118366.jpeg?_gl=1*18myfvu*_ga*NDc3MzY4NDYzLjE3NzY4MTQxNDQ.*_ga_8JE65Q40S6*czE3NzY4MTQxNDMkbzEkZzEkdDE3NzY4MTQzOTMkajMzJGwwJGgw"
                         Aspect="AspectFill"
                         Opacity="0.45"/>
                        <Button Text="4- Como funciona a Composteira?"
                          BackgroundColor="Transparent"
                          TextColor="#1B5E20"
                          FontAttributes="Bold"
                          FontSize="20"
                          Clicked="OnComoClicked"/>
                    </Grid>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- MENU INFERIOR (ROW 2) -->
    <Grid Grid.Row="2" BackgroundColor="White" Padding="5">


        <!-- BOTÃO HOME -->
        <VerticalStackLayout HorizontalOptions="Start"
                         Margin="10,10,0,0">

            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHomeClicked"/>
            </VerticalStackLayout.GestureRecognizers>

            <Label Text="🏠"
               FontSize="24"
               HorizontalOptions="Center"/>

        

        </VerticalStackLayout>

    </Grid>

    </Grid>
</ContentPage>