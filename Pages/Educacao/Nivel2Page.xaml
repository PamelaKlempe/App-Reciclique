<ContentPage 
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Class="AppReciclique.Pages.Educacao.Nivel2Page"
	NavigationPage.HasNavigationBar="False"
	BackgroundColor="#F5F5F5">


    <Grid>
        <!-- FUNDO -->
        <Image Source="folhabonus.jpeg"
		   Aspect="AspectFill"
		   Opacity="0.98"/>

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- TOPO -->
            <VerticalStackLayout
			BackgroundColor="Transparent"
			Spacing="5"
			Padding="0,35,0,0"
			Grid.Row="0">

                <Label Text="♻️ NÍVEL 2"
				   TextColor="#1B365D"
				   FontSize="23"
				   HorizontalOptions="Center"
				   FontFamily="MontserratExtraBold"
				   FontAttributes="Bold"/>

                <Label Text="LIXO ORGÂNICO E ALIMENTO"
				   TextColor="#1B364A"
				   FontSize="15"
				   HorizontalOptions="Center"
				   FontFamily="MontserratExtraBold"
				   FontAttributes="Bold"/>

                <BoxView HeightRequest="3"
					 WidthRequest="300"
					 Color="#7FA87C"
					 CornerRadius="4"
					 HorizontalOptions="Center"/>

            </VerticalStackLayout>

            <!-- CONTEÚDO -->
            <ScrollView Grid.Row="1">

                <VerticalStackLayout Padding="20" Spacing="18">

                    <!-- CARD 1 -->
                    <Frame CornerRadius="18"
					   BackgroundColor="#EEF5EA"
					   BorderColor="#BFCDB8"
					   Padding="15"
					   HasShadow="True">

                        <VerticalStackLayout>

                            <Label Text="1️⃣ - Lixo Orgânico"
							   FontFamily="MontserratExtraBold"
								   FontAttributes="Bold"
							   FontSize="18"
							   TextColor="#1B5E20"/>

                            <Image Source="lixoorganico.jpg"
							   HeightRequest="110"
							   Aspect="AspectFill"
							   Margin="0,10,0,0"/>

                        </VerticalStackLayout>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLixoOrganicoClicked"/>
                        </Frame.GestureRecognizers>

                    </Frame>

                    <!-- CARD 2 -->
                    <Frame CornerRadius="18"
					   BackgroundColor="#EEF5EA"
					   BorderColor="#BFCDB8"
					   Padding="15"
					   HasShadow="True">

                        <VerticalStackLayout>

                            <Label Text="2️⃣ -  O que é Compostagem"
							   FontFamily="MontserratExtraBold"
								   FontAttributes="Bold"
							   FontSize="18"
							   TextColor="#1B5E20"/>

                            <Image Source= "compostagem1.jpg"
							   HeightRequest="110"
							   Aspect="AspectFill"
							   Margin="0,10,0,0"/>

                        </VerticalStackLayout>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCompostagemClicked"/>
                        </Frame.GestureRecognizers>

                    </Frame>

                    <!-- CARD 3 -->
                    <Frame CornerRadius="18"
					   BackgroundColor="#EEF5EA"
					   BorderColor="#BFCDB8"
					   Padding="15"
					   HasShadow="True">

                        <VerticalStackLayout>

                            <Label Text="3️⃣ - Compostagem em Casa"
							   FontFamily="MontserratExtraBold"
							   FontAttributes="Bold"
							   FontSize="18"
							   TextColor="#1B5E20"/>

                            <Image Source="compostagem2.jpg"
							   HeightRequest="110"
							   Aspect="AspectFill"
							   Margin="0,10,0,0"/>

                        </VerticalStackLayout>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPassosClicked"/>
                        </Frame.GestureRecognizers>

                    </Frame>

                    <!-- CARD 4 -->
                    <Frame CornerRadius="18"
					   BackgroundColor="#EEF5EA"
					   BorderColor="#BFCDB8"
					   Padding="15"
					   HasShadow="True">

                        <VerticalStackLayout>

                            <Label Text="4️⃣ - Composteira"
							   FontFamily="MontserratExtraBold"
								   FontAttributes="Bold"
							   FontSize="18"
							   TextColor="#1B5E20"/>

                            <Image Source="composteira.jpg"
							   HeightRequest="110"
							   Aspect="AspectFill"
							   Margin="0,10,0,0"/>

                        </VerticalStackLayout>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnComoClicked"/>
                        </Frame.GestureRecognizers>

                    </Frame>

                </VerticalStackLayout>

            </ScrollView>


            <!-- MENU INFERIOR (ROW 2) -->
            <Grid Grid.Row="2" BackgroundColor="White" Padding="5">


                <!-- BOTÃO HOME -->
                <VerticalStackLayout HorizontalOptions="Start"
						 Margin="10,10,0,0">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeClicked"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <Label Text="🏠"
					FontSize="24"
					HorizontalOptions="Center"/>



                </VerticalStackLayout>

            </Grid>

        </Grid>
    </Grid>
</ContentPage>
