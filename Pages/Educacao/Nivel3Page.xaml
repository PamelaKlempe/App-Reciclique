<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppReciclique.Pages.Educacao.Nivel3Page"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- TOPO (ROW 0) -->
        <VerticalStackLayout BackgroundColor="#2E7D32" Padding="10" Grid.Row="0">

            <Label Text="←"
           TextColor="White"
           FontSize="20">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVoltarClicked"/>
                </Label.GestureRecognizers>
            </Label>

            <Label Text="NÍVEL 3 — RESÍDUOS PERIGOSOS"
           TextColor="white"
           FontSize="12"
             FontAttributes="Bold"/>
        </VerticalStackLayout>



        <!-- CONTEÚDO (ROW 1) -->

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- BOTÃO 1 -->
                <Frame CornerRadius="18" HeightRequest="140">
                    <Grid>
                        <Image Source="https://images.pexels.com/photos/2768961/pexels-photo-2768961.jpeg?_gl=1*1k8cjui*_ga*NDc3MzY4NDYzLjE3NzY4MTQxNDQ.*_ga_8JE65Q40S6*czE3NzcxNTg0NzkkbzIkZzEkdDE3NzcxNTk5MzIkajQ5JGwwJGgw"
                Aspect="AspectFill"
                Opacity="0.45"/>

                        <Button Text="1- O que é Perigosos?"
                 BackgroundColor="Transparent"
                 TextColor="#1B5E20"
                 FontAttributes="Bold"
                 FontSize="20"
                 Clicked="OnOqueClicked"/>
                    </Grid>
                </Frame>

                <!-- BOTÃO 2 -->
                <Frame CornerRadius="18" HeightRequest="140">
                    <Grid>
                        <Image Source="https://images.pexels.com/photos/3806781/pexels-photo-3806781.jpeg?_gl=1*18w7yby*_ga*NDc3MzY4NDYzLjE3NzY4MTQxNDQ.*_ga_8JE65Q40S6*czE3NzcxNTg0NzkkbzIkZzEkdDE3NzcxNTk5OTMkajUxJGwwJGgw"
                Aspect="AspectFill"
                Opacity="0.45"/>
                        <Button Text="2- O que é Resíduos Tóxicos?"
                 BackgroundColor="Transparent"
                 TextColor="#1B5E20"
                 FontAttributes="Bold"
                 FontSize="20"
                 Clicked="OnToxicoClicked"/>
                    </Grid>
                </Frame>

                <!-- BOTÃO 3 -->
                <Frame CornerRadius="18" HeightRequest="140">
                    <Grid>
                        <Image Source="https://images.pexels.com/photos/15369763/pexels-photo-15369763.jpeg?_gl=1*2bq8ac*_ga*NDc3MzY4NDYzLjE3NzY4MTQxNDQ.*_ga_8JE65Q40S6*czE3NzcxNTg0NzkkbzIkZzEkdDE3NzcxNjAyMTUkajUkbDAkaDA."
                Aspect="AspectFill"
                Opacity="0.45"/>
                        <Button Text="3- Classificação e como tratar?"
                 BackgroundColor="Transparent"
                 TextColor="#1B5E20"
                 FontAttributes="Bold"
                 FontSize="20"
                 Clicked="OnTratarClicked"/>
                    </Grid>
                </Frame>

                <!-- BOTÃO 4 -->
                <Frame CornerRadius="18" HeightRequest="140">
                    <Grid>
                        <Image Source="https://images.pexels.com/photos/8770242/pexels-photo-8770242.jpeg?_gl=1*y649fj*_ga*NDc3MzY4NDYzLjE3NzY4MTQxNDQ.*_ga_8JE65Q40S6*czE3NzcxNTg0NzkkbzIkZzEkdDE3NzcxNTk1MDEkajM0JGwwJGgw"
                Aspect="AspectFill"
                Opacity="0.45"/>
                        <Button Text="4-  NBR 10004 - Fluxograma"
                 BackgroundColor="Transparent"
                 TextColor="#1B5E20"
                 FontAttributes="Bold"
                 FontSize="20"
                 Clicked="OnIdentifcarClicked"/>
                    </Grid>
                </Frame>

                <!-- BOTÃO 5 -->
                <Frame CornerRadius="18" HeightRequest="140">
                    <Grid>
                        <Image Source="https://images.pexels.com/photos/34054388/pexels-photo-34054388.jpeg?_gl=1*52ll4t*_ga*NDc3MzY4NDYzLjE3NzY4MTQxNDQ.*_ga_8JE65Q40S6*czE3NzcxNTg0NzkkbzIkZzEkdDE3NzcxNTkwNjUkajM1JGwwJGgw"
 Aspect="AspectFill"
 Opacity="0.45"/>
                        <Button Text="5- Curiosidade Animada!"
  BackgroundColor="Transparent"
  TextColor="#1B5E20"
  FontAttributes="Bold"
  FontSize="20"
  Clicked="OnCuriosidadeClicked"/>
                    </Grid>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- MENU HOME (ROW 2) -->
        <Grid Grid.Row="2" BackgroundColor="White" Padding="10">

            <!-- LINHA VERDE -->
            <BoxView HeightRequest="2"
             BackgroundColor="#2E7D32"
             VerticalOptions="Start"/>

            <!-- BOTÃO HOME -->
            <VerticalStackLayout HorizontalOptions="Start"
                         Margin="10,10,0,0">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeClicked"/>
                </VerticalStackLayout.GestureRecognizers>

                <Label Text="🏠"
               FontSize="24"
               HorizontalOptions="Center"/>

                <Label Text="Home"
               FontSize="10"
               HorizontalOptions="Center"/>

            </VerticalStackLayout>

        </Grid>

    </Grid>
</ContentPage>