<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppReciclique.NotificacoesPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- TOPO -->
        <VerticalStackLayout BackgroundColor="#2E7D32" Padding="10" Grid.Row="0">

            <Label Text="←"
                   TextColor="White"
                   FontSize="20">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVoltarClicked"/>
                </Label.GestureRecognizers>
            </Label>

            <Label Text="Últimos avisos"
                   TextColor="White"
                   FontSize="16"
                   FontAttributes="Bold"/>

        </VerticalStackLayout>

        <!-- LISTA DE NOTIFICAÇÕES -->
        <CollectionView Grid.Row="1"
                        x:Name="cvNotificacoes"
                        Margin="20">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame BackgroundColor="White"
                           CornerRadius="12"
                           Padding="12"
                           Margin="0,5">

                        <Label Text="{Binding .}"
                               TextColor="#1B5E20"
                               FontSize="16"
                               LineBreakMode="WordWrap"/>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- MENU -->
        <Grid Grid.Row="2" BackgroundColor="White" Padding="10">

            <BoxView HeightRequest="2"
                     BackgroundColor="#2E7D32"
                     VerticalOptions="Start"/>

            <VerticalStackLayout HorizontalOptions="Start"
                                 Margin="10,10,0,0">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeClicked"/>
                </VerticalStackLayout.GestureRecognizers>

                <Label Text="🏠" FontSize="24"/>
                <Label Text="Home" FontSize="10"/>

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>