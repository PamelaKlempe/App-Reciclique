<ContentPage  
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppReciclique.AjudaPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">


    <Grid>
        <!-- FUNDO -->
        <Image Source="folhasajuda.jpeg"
            Aspect="AspectFill"
              Opacity="0.90"/>


        <Grid RowDefinitions="Auto,*,Auto">

            <!-- TOPO -->
            <VerticalStackLayout 
 BackgroundColor="Transparent" 
Spacing="5"
 Padding="20,20,20,0"
 Grid.Row="0">

                <Label Text=  "Ajuda e Suporte"
    TextColor="#1f6b3a"
    FontSize="25"
    FontAttributes="Bold"/>

            </VerticalStackLayout>

            <!-- CONTEÚDO -->
            <ScrollView Grid.Row="1">

                <VerticalStackLayout Padding="20" Spacing="9">

                    <!-- TEXTO -->
                    <Label Text="Precisa de ajuda? Preencha o formulário ou entre em contato:"
                       FontSize="14"
                       TextColor="Gray"/>

                    <!-- CONTATO -->
                    <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="10">

                        <VerticalStackLayout Spacing="5">

                            <Label Text="📞 (14) 3400-0101"
                               FontSize="14"
                               TextColor="#2E7D32"/>

                            <Label Text="📧 suporte@reciclique.com"
                               FontSize="14"
                               TextColor="#2E7D32"/>

                        </VerticalStackLayout>

                    </Frame>

                    <!-- FORMULÁRIO -->
                    <Entry Placeholder="Seu nome"
                       x:Name="txtNome"/>

                    <Entry Placeholder="Seu e-mail"
                       Keyboard="Email"
                       x:Name="txtEmail"/>

                    <Entry Placeholder="Telefone"
                       Keyboard="Telephone"
                       x:Name="txtTelefone"/>

                    <Editor Placeholder="Digite sua dúvida ou sugestão..."
                        HeightRequest="100"
                        x:Name="txtMensagem"/>

                    <!-- BOTÃO -->
                    <Button Text="Enviar"
                        BackgroundColor="#2E7D32"
                        TextColor="White"
                        CornerRadius="8"
                        Clicked="OnEnviarClicked"/>

                </VerticalStackLayout>

            </ScrollView>

            <!-- MENU -->
            <Grid Grid.Row="2" BackgroundColor="#F8f8f4" Padding="1">

                

                <VerticalStackLayout HorizontalOptions="Start"
                                 Margin="10,10,0,0">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeClicked"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <Label Text="🏠" FontSize="24"/>
                   

                </VerticalStackLayout>

            </Grid>

        </Grid>
        
    </Grid>

</ContentPage>