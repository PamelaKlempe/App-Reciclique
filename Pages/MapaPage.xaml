<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppReciclique.MapaPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">
    
    
    <Grid>
        <!-- FUNDO -->
        <Image Source="folhaspadrao2.jpeg"
               Aspect="AspectFill"
               Opacity="0.80"/>

        <Grid RowDefinitions="Auto,*,Auto">

        <!-- TOPO -->
            <VerticalStackLayout 
 BackgroundColor="Transparent" 
Spacing="5"
 Padding="30,30,20,0"
 Grid.Row="0">

                <Label Text=  "Mapa da Cidade"
    TextColor="#1f6b3a"
    FontSize="25"
    FontAttributes="Bold"/>

            </VerticalStackLayout>


            <!-- MAPA via WebView -->
        <WebView x:Name="MapaWebView"
                 Grid.Row="1" />

        <!-- MENU INFERIOR -->
        <Grid Grid.Row="2" BackgroundColor="#f8f8f4" Padding="3">
            
            <VerticalStackLayout HorizontalOptions="Start" Margin="10,10,0,0">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeClicked"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="🏠" FontSize="24" HorizontalOptions="Center"/>
               
            </VerticalStackLayout>
        </Grid>
    </Grid>

    </Grid>
</ContentPage>