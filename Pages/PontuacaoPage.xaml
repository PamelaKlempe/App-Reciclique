<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppReciclique.PontuacaoPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">


    <Grid>
        <!-- FUNDO -->
        <Image Source="folhaspadrao.jpeg"
      Aspect="AspectFill"
        Opacity="0.90"/>



        <Grid RowDefinitions="Auto,*,Auto">

            <!-- TOPO -->
            <VerticalStackLayout 
 BackgroundColor="Transparent" 
Spacing="5"
 Padding="20,30,20,0"
 Grid.Row="0">

                <Label Text=  "Meus Pontos"
    TextColor="#1f6b3a"
    FontSize="25"
    FontAttributes="Bold"/>

            </VerticalStackLayout>

     

            <!-- CONTEÚDO -->
            <ScrollView Grid.Row="1">

                <VerticalStackLayout Padding="20" Spacing="20">

                    <!-- PONTOS -->
                    <Frame CornerRadius="20" BackgroundColor="#E8F5E9" Padding="15">
                        <HorizontalStackLayout Spacing="15" VerticalOptions="Center">

                            <Image Source="medalha.png"
                                HeightRequest="55"
                                WidthRequest="55"
                                HorizontalOptions="Center"/>

                            <VerticalStackLayout>
                                <Label Text="Total de Pontos"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#2E7D32"/>

                                <Label x:Name="lblPontos"
                                   FontSize="28"
                                   FontAttributes="Bold"/>
                            </VerticalStackLayout>

                        </HorizontalStackLayout>
                    </Frame>

                    <!-- NÍVEL -->
                    <Frame CornerRadius="20" BackgroundColor="#E3F2FD" Padding="15">
                        <HorizontalStackLayout Spacing="15" VerticalOptions="Center">

                            <Image x:Name="imgNivel"
                            HeightRequest="55"
                            WidthRequest="55"
                            HorizontalOptions="Center"/>

                            <VerticalStackLayout>
                                <Label Text="Meu Nível"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#2E7D32"/>

                                <Label x:Name="lblNivel"
                                   FontSize="24"
                                   FontAttributes="Bold"/>
                            </VerticalStackLayout>

                        </HorizontalStackLayout>
                    </Frame>

                    <!-- COLETAS -->
                    <Frame CornerRadius="20" BackgroundColor="#FFF3E0" Padding="15">
                        <HorizontalStackLayout Spacing="15" VerticalOptions="Center">

                            <Image Source= "coletas.png"
                             HeightRequest="55"
                               WidthRequest="55"
                             HorizontalOptions="Center"/>

                            <VerticalStackLayout>
                                <Label Text="Total de Coletas"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#2E7D32"/>

                                <Label x:Name="lblColetas"
                                   Text="0"
                                   FontSize="24"
                                   FontAttributes="Bold"/>
                            </VerticalStackLayout>

                        </HorizontalStackLayout>
                    </Frame>

                    <!-- EXPLICAÇÃO -->
                    <Frame CornerRadius="15" BackgroundColor="#F1F8E9" Padding="15">

                        <VerticalStackLayout Spacing="12">

                            <Label Text="Entenda seus pontos"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="#2E7D32"/>

                            <!-- AGENDAMENTO -->
                            <Label Text="🚮 Ganhe pontos ao agendar coletas:"
                               FontAttributes="Bold"
                               FontSize="16"/>

                            <VerticalStackLayout Spacing="2">
                                <Label Text="✔️ 30 pontos para cada coleta normal" FontSize="15"/>
                                <Label Text="✔️ 50 pontos para cada Super Coleta" FontSize="15"/>
                            </VerticalStackLayout>

                            <!-- EDUCAÇÃO -->
                            <Label Text="♻️ Ganhe pontos ao acessar conteúdos educativos:"
                               FontAttributes="Bold"
                               FontSize="16"/>

                            <Label Text="✔️ A cada etapa da trilha educativa acessada você ganha pontos e sobe de nível"
                               FontSize="15"
                               LineBreakMode="WordWrap"/>

                            <!-- BENEFÍCIOS -->
                            <Label Text="🎁 Troque seus pontos por benefícios:"
                               FontAttributes="Bold"
                               FontSize="16"/>

                            <Label Text="✔️ Acumule pontos e troque por cashback e recompensas em nossas lojas parceiras"
                               FontSize="15"
                               LineBreakMode="WordWrap"/>

                        </VerticalStackLayout>

                    </Frame>

                </VerticalStackLayout>

            </ScrollView>

            <!-- MENU -->
            <Grid Grid.Row="2" BackgroundColor="#f8f8f4" Padding="5">



                <VerticalStackLayout HorizontalOptions="Start"
                                 Margin="10,10,0,0">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeClicked"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <Label Text="🏠" FontSize="25"/>


                </VerticalStackLayout>

            </Grid>

        </Grid>
    </Grid>

</ContentPage>