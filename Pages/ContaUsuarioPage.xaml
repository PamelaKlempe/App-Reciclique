<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppReciclique.ContaUsuarioPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- TOPO -->
        <VerticalStackLayout 
            BackgroundColor="#2E7D32" 
            Padding="15"
            Spacing="10"
            Grid.Row="0">

            <Label Text="←"
                   TextColor="White"
                   FontSize="20">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVoltarClicked"/>
                </Label.GestureRecognizers>
            </Label>

            <Label Text="MINHA CONTA"
                   TextColor="White"
                   FontSize="16"
                   FontAttributes="Bold"/>


        </VerticalStackLayout>

        <!-- CONTEÚDO -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="25" Spacing="20">

                <Frame BackgroundColor="White"
                       CornerRadius="15"
                       Padding="20">

                    <VerticalStackLayout Spacing="12">

                        <!-- TÍTULO -->
                        <Label Text="Dados do Usuário"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#2E7D32"/>

                        <!-- ID -->
                        <HorizontalStackLayout>
                            <Label Text="ID:"
                                   FontAttributes="Bold"
                                   TextColor="#2E7D32"/>
                            <Label x:Name="lblId"/>
                        </HorizontalStackLayout>

                        <!-- NOME -->
                        <HorizontalStackLayout>
                            <Label Text="Nome:"
                                   FontAttributes="Bold"
                                   TextColor="#2E7D32"/>
                            <Label x:Name="lblNome"/>
                        </HorizontalStackLayout>

                        <!-- EMAIL -->
                        <HorizontalStackLayout>
                            <Label Text="Email:"
                                   FontAttributes="Bold"
                                   TextColor="#2E7D32"/>
                            <Label x:Name="lblEmail"/>
                        </HorizontalStackLayout>

                        <!-- NASCIMENTO -->
                        <HorizontalStackLayout>
                            <Label Text="Nascimento:"
                                   FontAttributes="Bold"
                                   TextColor="#2E7D32"/>
                            <Label x:Name="lblNascimento"/>
                        </HorizontalStackLayout>

                        <!-- TELEFONE -->
                        <HorizontalStackLayout>
                            <Label Text="Telefone:"
                                   FontAttributes="Bold"
                                   TextColor="#2E7D32"/>
                            <Label x:Name="lblTelefone"/>
                        </HorizontalStackLayout>

                        <!-- ENDEREÇO -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">

                            <Label Text="Endereço:"
           FontAttributes="Bold"
           TextColor="#2E7D32"
           Grid.Column="0"/>

                            <Label x:Name="lblEndereco"
           Grid.Column="1"
           LineBreakMode="WordWrap"/>

                        </Grid>

                        <!-- CEP -->
                        <HorizontalStackLayout>
                            <Label Text="CEP:"
                                   FontAttributes="Bold"
                                   TextColor="#2E7D32"/>
                            <Label x:Name="lblCep"/>
                        </HorizontalStackLayout>

                        <!-- PLANO -->
                        <HorizontalStackLayout>
                            <Label Text="Plano:"
                                   FontAttributes="Bold"
                                   TextColor="#2E7D32"/>
                            <Label x:Name="lblPlano"
                                   FontAttributes="Bold"/>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Frame>

                <!-- TEXTO INSTITUCIONAL -->
                <Label Text="Aplicativo apoiado pela Prefeitura de Marília - SP"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       TextColor="Gray"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- RODAPÉ -->
        <Grid Grid.Row="2" BackgroundColor="White" Padding="10"
              ColumnDefinitions="*,Auto">

            <BoxView Grid.ColumnSpan="2"
                     HeightRequest="2"
                     BackgroundColor="#2E7D32"
                     VerticalOptions="Start"/>

            <!-- HOME -->
            <VerticalStackLayout Grid.Column="0"
                                 HorizontalOptions="Start"
                                 Margin="10,10,0,0">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeClicked"/>
                </VerticalStackLayout.GestureRecognizers>

                <Label Text="🏠" FontSize="24"/>
                <Label Text="Home" FontSize="10"/>

            </VerticalStackLayout>

            <!-- BOTÃO SAIR -->
            <Button Grid.Column="1"
                    Text="Sair"
                    Clicked="OnLogoutClicked"
                    BackgroundColor="#D32F2F"
                    TextColor="White"
                    HeightRequest="40"
                    WidthRequest="80"
                    CornerRadius="8"
                    VerticalOptions="Center"
                    Margin="0,10,10,0"/>

        </Grid>

    </Grid>
</ContentPage>