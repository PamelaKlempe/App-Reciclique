<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppReciclique.MainPage"
      
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
      RowSpacing="10">

        <!-- TOPO (ROW 0) -->
        <Label x:Name="lblSaudacao"
            Grid.Row="0"
           Text="Olá, Pamela"
           FontSize="18"
           FontAttributes="Bold"
           TextColor="#1B5E20"
           Margin="15,2,0,0"/>

        <!-- DASHBOARD (ROW 1) -->
        <Frame Grid.Row="1"
           Margin="10,0,10,0"
           Padding="8"
           CornerRadius="10"
           BackgroundColor="White"
           HasShadow="False">

            <Grid RowDefinitions="Auto,Auto"
                ColumnSpacing="20"
              ColumnDefinitions="*,*,*,*">

                <!-- LOGO -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Start" HeightRequest="50" Margin="0,-6,0,0">
                    <Image Source="logosemletra.png" HeightRequest="70" />

                </VerticalStackLayout>
                <!-- PONTOS -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="50">

                    <Label Text="🎖️" FontSize="19"/>
                    <Label x:Name="lblPontos" Text="120" FontSize="14" FontAttributes="Bold" TextColor="#1B5E20" HorizontalOptions="Center"/>

                </VerticalStackLayout>

                <!-- NÍVEL -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="50">
                    <Label Text="⚪" x:Name="lblIconeNivel" FontSize="16" HorizontalOptions="Center"/>
                    <Label x:Name="lblNivel" FontSize="14" FontAttributes="Bold" TextColor="#1B5E20" HorizontalOptions="Center"/>

       

                </VerticalStackLayout>

                <!-- COLETAS -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="50">
                    <Label Text="🚮" FontSize="17"/>
                    <Label x:Name="lblColetas" Text="0" FontSize="14"  FontAttributes="Bold" TextColor="#1B5E20" HorizontalOptions="Center"/>

                </VerticalStackLayout>

                <!-- LINHA VERDE -->
                <BoxView Grid.Row="1"
                   Grid.ColumnSpan="4"
                   HeightRequest="2"
                   BackgroundColor="#2E7D32"
                   VerticalOptions="End"
                   Margin="0,10,0,0"/>


            </Grid>
        </Frame>

        <!-- CONTEUDO  (ROW 2) -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="15" Spacing="20">

                <!-- MENU PRINCIPAL -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- AGENDAR -->
                    <Frame Grid.Column="0" BackgroundColor="#E8F5E9" CornerRadius="12" Padding="7" BorderColor="#2E7D32" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAgendarClicked"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="📅" FontSize="28" HorizontalOptions="Center"/>
                            <Label Text="AGENDAR" FontSize="8" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- PONTOS -->
                    <Frame Grid.Column="1" BackgroundColor="#E8F5E9" CornerRadius="12" Padding="7" BorderColor="#2E7D32" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPontosClicked"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="🏆" FontSize="28" HorizontalOptions="Center"/>
                            <Label Text="PONTUAÇÃO" FontSize="8" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- EDUCACAO -->
                    <Frame Grid.Column="2" BackgroundColor="#E8F5E9" CornerRadius="12" Padding="7" BorderColor="#2E7D32" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEducacaoClicked"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="♻️" FontSize="28" HorizontalOptions="Center"/>
                            <Label Text="TRILHA" FontSize="8" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- HISTORICO -->
                    <Frame Grid.Column="3" BackgroundColor="#E8F5E9" CornerRadius="12" Padding="7" BorderColor="#2E7D32" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHistoricoClicked"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="📋" FontSize="28" HorizontalOptions="Center"/>
                            <Label Text="HISTÓRICO" FontSize="8" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <!-- LOJAS PARCEIRAS-->
                <Frame Margin="1" Padding="2" CornerRadius="2" BackgroundColor="White" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="Lojas Parceiras:" FontSize="12" FontAttributes="Bold" TextColor="#1B5E20" Margin="5"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- CARROSSEL -->
                <CollectionView x:Name="carouselParceiros"
                ItemsLayout="HorizontalList"
                HeightRequest="120">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame WidthRequest="80" HeightRequest="80" Margin="3" CornerRadius="3" Padding="5" BackgroundColor="#F9F9F9" HasShadow="False">
                                <Image Source="{Binding}" Aspect="AspectFit">

                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBannerClicked"/>
                                    </Image.GestureRecognizers>

                                </Image>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- DICAS E QUIZ -->
                <VerticalStackLayout Margin="10,15,10,20" Spacing="12">

                    <!-- CARD ARTESANATO -->
                    <Frame BackgroundColor="#E8F5E9"
           CornerRadius="15"
           Padding="15"
           HasShadow="True">

                        <VerticalStackLayout Spacing="8">

                            <Label Text="🌸 Flores com Colheres Plásticas"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="#1B5E20"/>

                            <Label Text="Aprenda a transformar colheres descartáveis em flores decorativas sustentáveis."
                   FontSize="13"
                   TextColor="#444"/>

                            <Button Text="Ver Tutorial"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="40"
                    Clicked="OnTutorialClicked"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- CARD QUIZ -->
                    <Frame BackgroundColor="#F1F8E9"
           CornerRadius="15"
           Padding="15"
           HasShadow="True">

                        <VerticalStackLayout Spacing="8">

                            <Label Text="♻️ Teste Seus Conhecimentos"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="#33691E"/>

                            <Label Text="Descubra quanto você sabe sobre reciclagem e sustentabilidade."
                   FontSize="13"
                   TextColor="#444"/>

                            <Button Text="Fazer Quiz"
                    BackgroundColor="#558B2F"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="40"
                    Clicked="OnQuizClicked"/>
                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- MENU INFERIOR ( ROW 3) -->
        <Grid Grid.Row="3" BackgroundColor="White" Padding="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="2"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <BoxView BackgroundColor="#2E7D32" Grid.Row="0"/>

            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- HOME -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeClicked"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🏠" FontSize="20" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- MAPA -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMapaClicked"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="📍" FontSize="20" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- AVISOS -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNotificacoesClicked"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🔔" FontSize="20" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- CONTA -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContaClicked"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="👤" FontSize="20" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- AJUDA -->
                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAjudaClicked"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="❓" FontSize="20" HorizontalOptions="Center"/>
                </VerticalStackLayout>

            </Grid>
        </Grid>

    </Grid>
</ContentPage>
